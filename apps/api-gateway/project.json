{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api-gateway",
  "root": "apps/api-gateway",
  "projectType": "application",
  "implicitDependencies": [
    "shared"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "go test -mod=readonly -count=1 ./...",
        "env": {
          "GOWORK": "off"
        }
      }
    }
  }
}
