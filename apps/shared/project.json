{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "shared",
  "root": "apps/shared",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "go test -mod=readonly -count=1 ./...",
        "env": {
          "GOWORK": "off"
        }
      }
    }
  }
}
